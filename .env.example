# Supabase configuration for client-side API calls (public-safe with Row-Level Security)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# SerpApi Key for Google Search and Google Shopping scraping (server-side only)
SERP_API_KEY=your_serp_api_key

# Telegram configuration for chat or notifications (server-side only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Gemini API Key for smart suggestions and classification (server-side only)
GEMINI_API_KEY=your_gemini_api_key
